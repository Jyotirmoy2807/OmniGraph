# ============================================================================
# OMNIGRAPH ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. FalkorDB Connection Settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# 2. LLM Provider Settings (Used for Schema-Enforced Ingestion & Reasoning)
# Supported LLM_PROVIDER values: "openai" | "groq" | "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 3. Backend Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Next.js Public API Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
